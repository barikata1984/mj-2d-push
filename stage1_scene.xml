<mujoco model="stage1_push">
  <!--
    Stage 1: UR5e + Robotiq 2F-85 pushing a rectangular slider along +Y on a table.
    Robot base at (0, 0.1, 0.3) on table surface.
    Slider starts near y=0.24, pushed toward y=0.8.

    Dependency: /workspace/assets/ (UR5e + Robotiq mesh files)
    Dependency: /workspace/ur5e_with_gripper.xml (UR5e + Robotiq 2F-85)
  -->

  <compiler angle="radian" autolimits="true"/>

  <option integrator="implicitfast" timestep="0.002" cone="elliptic" impratio="10">
    <flag warmstart="enable"/>
  </option>

  <include file="ur5e_with_gripper.xml"/>

  <statistic center="0 0.4 0.35" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="1920" offheight="1440"/>
  </visual>

  <default>
    <default class="slider_contact">
      <geom condim="4" friction="0.35 0.005 0.001"
        solref="0.02 1" solimp="0.9 0.95 0.001 0.5 2"/>
    </default>
    <default class="table_contact">
      <geom condim="4" friction="0.5 0.005 0.001"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
      width="512" height="3072"/>
    <texture type="2d" name="table_tex" builtin="checker" mark="edge"
      rgb1="0.6 0.6 0.6" rgb2="0.5 0.5 0.5" markrgb="0.4 0.4 0.4"
      width="300" height="300"/>
    <material name="table_mat" texture="table_tex" texuniform="true"
      texrepeat="3 3" reflectance="0.1"/>
    <material name="slider_mat" rgba="0.2 0.6 0.85 1"
      specular="0.3" shininess="0.2"/>
    <material name="work_mat" rgba="0.80 0.66 0.45 1"
      specular="0.1" shininess="0.1" reflectance="0.0"/>
  </asset>

  <worldbody>
    <light pos="0 0.4 1.5" dir="0 0 -1" directional="true"/>

    <!-- Table: surface at z=0.3, extended in +y (to y=1.1) to fully support the work surface -->
    <body name="table" pos="0 0.55 0.275">
      <geom name="table_surface" type="box" size="0.5 0.55 0.025"
        class="table_contact" material="table_mat" mass="50"/>
    </body>

    <!-- Work surface: 0.65 x 0.60 m beige board, 27 mm thick, resting on the table.
         Base-frame footprint: y in [0.35, 0.95], x in [-0.325, 0.325]
         (world y [0.45, 1.05], world x [-0.325, 0.325]); top at z=0.327. -->
    <body name="work_surface" pos="0 0.75 0.3135">
      <geom name="work_surface_geom" type="box" size="0.325 0.3 0.0135"
        class="table_contact" material="work_mat" mass="20"/>
    </body>

    <!-- Goal marker: base (0, 0.8) = world (0, 0.9), on the work-surface top (z=0.327) -->
    <site name="goal_mark" pos="0 0.9 0.328" type="cylinder" size="0.025 0.001"
      rgba="1 0 0 1"/>

    <!-- Slider: 80x60x30 mm block (Hogan 2016: m=1.05 kg), resting on the work surface.
         Base-frame start (0, 0.4); z = work-surface top 0.327 + half-height 0.015 = 0.342. -->
    <body name="slider" pos="0 0.5 0.342">
      <freejoint name="slider_joint"/>
      <inertial mass="1.05" pos="0 0 0"
        diaginertia="0.000394 0.000525 0.000164"/>
      <geom name="slider_geom" type="box" size="0.04 0.03 0.015"
        class="slider_contact" material="slider_mat"/>
      <site name="slider_center" pos="0 0 0" size="0.003" rgba="1 0 0 1"/>
      <site name="slider_corner_pp" pos="0.04 0.03 0" size="0.002" rgba="0 1 0 1"/>
      <site name="slider_corner_np" pos="-0.04 0.03 0" size="0.002" rgba="0 0 1 1"/>
      <site name="slider_corner_nn" pos="-0.04 -0.03 0" size="0.002" rgba="1 1 0 1"/>
      <site name="slider_corner_pn" pos="0.04 -0.03 0" size="0.002" rgba="1 0 1 1"/>
    </body>

    <!-- Top-down camera centered on push area -->
    <camera name="top_down" pos="0 0.5 1.2" xyaxes="1 0 0 0 1 0" fovy="45"/>
    <!-- Side view -->
    <camera name="side" pos="0.7 0.5 0.55" xyaxes="0 1 0 -0.25 0 0.97" fovy="60"/>
    <!-- Tracking camera on slider -->
    <camera name="slider_track" mode="targetbodycom" target="slider"
      pos="0.35 0.5 0.65" fovy="50"/>
  </worldbody>

  <contact>
    <!-- Robot base sits on table — exclude to prevent jitter -->
    <exclude body1="base" body2="table"/>
    <!-- Wrist/gripper collision bodies vs table: the conservative collision
         capsules extend well beyond the visual mesh at table height. Exclude
         to allow the arm to work at table-surface level. -->
    <exclude body1="wrist_1_link" body2="table"/>
    <exclude body1="wrist_2_link" body2="table"/>
    <exclude body1="wrist_3_link" body2="table"/>
    <exclude body1="gripper" body2="table"/>
    <exclude body1="gripper_base_mount" body2="table"/>
    <exclude body1="gripper_base" body2="table"/>
    <exclude body1="gripper_right_driver" body2="table"/>
    <exclude body1="gripper_right_coupler" body2="table"/>
    <exclude body1="gripper_right_spring_link" body2="table"/>
    <exclude body1="gripper_right_follower" body2="table"/>
    <exclude body1="gripper_right_pad" body2="table"/>
    <exclude body1="gripper_left_driver" body2="table"/>
    <exclude body1="gripper_left_coupler" body2="table"/>
    <exclude body1="gripper_left_spring_link" body2="table"/>
    <exclude body1="gripper_left_follower" body2="table"/>
    <exclude body1="gripper_left_pad" body2="table"/>

    <!-- Same wrist/gripper exclusions vs the work surface (arm operates above it) -->
    <exclude body1="wrist_1_link" body2="work_surface"/>
    <exclude body1="wrist_2_link" body2="work_surface"/>
    <exclude body1="wrist_3_link" body2="work_surface"/>
    <exclude body1="gripper" body2="work_surface"/>
    <exclude body1="gripper_base_mount" body2="work_surface"/>
    <exclude body1="gripper_base" body2="work_surface"/>
    <exclude body1="gripper_right_driver" body2="work_surface"/>
    <exclude body1="gripper_right_coupler" body2="work_surface"/>
    <exclude body1="gripper_right_spring_link" body2="work_surface"/>
    <exclude body1="gripper_right_follower" body2="work_surface"/>
    <exclude body1="gripper_right_pad" body2="work_surface"/>
    <exclude body1="gripper_left_driver" body2="work_surface"/>
    <exclude body1="gripper_left_coupler" body2="work_surface"/>
    <exclude body1="gripper_left_spring_link" body2="work_surface"/>
    <exclude body1="gripper_left_follower" body2="work_surface"/>
    <exclude body1="gripper_left_pad" body2="work_surface"/>

    <!-- Slider-table: mu=0.35, condim=4 for torsional friction (Hogan 2016) -->
    <pair geom1="slider_geom" geom2="table_surface" condim="4"
      friction="0.35 0.35 0.005 0.001 0.001"
      solref="0.02 1" solimp="0.9 0.95 0.001 0.5 2"/>

    <!-- Slider-work surface: same friction model as the table -->
    <pair geom1="slider_geom" geom2="work_surface_geom" condim="4"
      friction="0.35 0.35 0.005 0.001 0.001"
      solref="0.02 1" solimp="0.9 0.95 0.001 0.5 2"/>

    <!-- Gripper pad vs slider: mu=0.3, condim=4 (Hogan 2016 pusher-slider) -->
    <pair geom1="gripper_right_pad1" geom2="slider_geom" condim="4"
      friction="0.3 0.3 0.005 0.001 0.001"
      solref="0.004 1" solimp="0.95 0.99 0.001 0.5 2"/>
    <pair geom1="gripper_right_pad2" geom2="slider_geom" condim="4"
      friction="0.3 0.3 0.005 0.001 0.001"
      solref="0.004 1" solimp="0.95 0.99 0.001 0.5 2"/>
    <pair geom1="gripper_left_pad1" geom2="slider_geom" condim="4"
      friction="0.3 0.3 0.005 0.001 0.001"
      solref="0.004 1" solimp="0.95 0.99 0.001 0.5 2"/>
    <pair geom1="gripper_left_pad2" geom2="slider_geom" condim="4"
      friction="0.3 0.3 0.005 0.001 0.001"
      solref="0.004 1" solimp="0.95 0.99 0.001 0.5 2"/>
  </contact>

  <keyframe>
    <!-- qpos: 6 arm + 8 gripper (closed) + 7 slider_freejoint = 21 values
         ctrl: 6 arm + 1 gripper (255=closed) = 7 values -->
    <key name="ready"
      qpos="1.1992 -1.6185 2.4502 -2.4025 -1.5708 -0.3716
             0.782171 0.000500 0.780958 -0.757842 0.782169 0.000503 0.780896 -0.758075
             0 0.5 0.342 1 0 0 0"
      ctrl="1.1992 -1.6249 2.4427 -2.4073 -1.5708 -0.3716 255"/>
  </keyframe>
</mujoco>
